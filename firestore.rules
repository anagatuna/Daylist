rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // El nuevo arreglo agrega exactamente un elemento (mi propio uid) respecto
    // al viejo, sin quitar ni cambiar nada más.
    function addedSelfOnly(oldArr, newArr) {
      return newArr.size() == oldArr.size() + 1
             && request.auth.uid in newArr
             && !(request.auth.uid in oldArr)
             && newArr.hasAll(oldArr);
    }

    // El nuevo arreglo quita exactamente un elemento (mi propio uid) respecto
    // al viejo, sin agregar ni cambiar nada más.
    function removedSelfOnly(oldArr, newArr) {
      return oldArr.size() == newArr.size() + 1
             && request.auth.uid in oldArr
             && !(request.auth.uid in newArr)
             && oldArr.hasAll(newArr);
    }

    match /users/{uid} {
      allow read: if isAuth();
      allow create: if isOwner(uid);
      // El dueño puede editar todo. Cualquier otro usuario autenticado solo
      // puede agregar su propio uid a friendRequests (enviar solicitud), o
      // agregar/quitar su propio uid en friends (aceptar/eliminar amistad) —
      // nunca tocar las entradas de alguien más.
      allow update: if isOwner(uid) || (
        isAuth() && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendRequests'])
            && addedSelfOnly(resource.data.get('friendRequests', []), request.resource.data.get('friendRequests', []))
          ) || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends'])
            && (
              addedSelfOnly(resource.data.get('friends', []), request.resource.data.get('friends', []))
              || removedSelfOnly(resource.data.get('friends', []), request.resource.data.get('friends', []))
            )
          )
        )
      );
    }

    // Tokens de Spotify sincronizados entre dispositivos, solo para esta cuenta
    // (el resto de usuarios conecta Spotify por dispositivo, vía storage local).
    match /spotifyTokens/{uid} {
      allow read, write: if isAuth() && isOwner(uid) && request.auth.token.email == 'altc3456@gmail.com';
    }

    match /posts/{postId} {
      allow read: if isAuth();
      allow create: if isOwner(request.resource.data.uid);
      // El dueño puede editar todo; cualquier usuario autenticado puede editar
      // solo reactions (reaccionar) o commentCounts (comentar en posts ajenos)
      allow update: if isOwner(resource.data.uid)
                    || (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']))
                    || (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCounts']));
      allow delete: if isOwner(resource.data.uid);

      match /comments/{commentId} {
        allow read: if isAuth();
        allow create: if isAuth() && isOwner(request.resource.data.uid);
        allow delete: if isAuth() && isOwner(resource.data.uid);
      }
    }
  }
}
