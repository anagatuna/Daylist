rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isAuth();
      allow create: if isOwner(uid);
      // El dueño puede editar todo; cualquier usuario autenticado puede editar
      // solo los campos friends/friendRequests (para solicitudes y amistades)
      allow update: if isOwner(uid)
                    || (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends', 'friendRequests']));
    }

    // Tokens de Spotify sincronizados entre dispositivos, solo para esta cuenta
    // (el resto de usuarios conecta Spotify por dispositivo, vía storage local).
    match /spotifyTokens/{uid} {
      allow read, write: if isAuth() && isOwner(uid) && request.auth.token.email == 'altc3456@gmail.com';
    }

    match /posts/{postId} {
      allow read: if isAuth();
      allow create: if isOwner(request.resource.data.uid);
      // El dueño puede editar todo; cualquier usuario autenticado puede editar
      // solo el campo reactions (para dejar reacciones en posts ajenos)
      allow update: if isOwner(resource.data.uid)
                    || (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']));
      allow delete: if isOwner(resource.data.uid);

      match /comments/{commentId} {
        allow read: if isAuth();
        allow create: if isAuth() && isOwner(request.resource.data.uid);
        allow delete: if isAuth() && isOwner(resource.data.uid);
      }
    }
  }
}
